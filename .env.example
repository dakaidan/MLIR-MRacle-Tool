# Copy to .env and fill in local CloudLab credentials.
# The token is the raw Portal API token string. Do not prefix it with "Bearer".
CLOUDLAB_TOKEN=
CLOUDLAB_PROJECT=
CLOUDLAB_USER=

# Optional overrides.
# CLOUDLAB_API_BASE=https://boss.emulab.net:43794
# CLOUDLAB_PROFILE_PROJECT=PortalProfiles
# CLOUDLAB_OS_IMAGE=default
# CLOUDLAB_SSH_KEY=~/.ssh/id_ed25519
# CLOUDLAB_SSHPUBKEY=~/.ssh/id_ed25519.pub
