# Cargo does not understand CMake's transitive archive dependencies. Export
# their resolved paths, including LLVM/MLIR and system libraries, for Rust's
# final link. A linker group in build.rs handles cycles between static archives.
function(mracle_collect_link item)
    if("${item}" MATCHES "^\\$<(LINK_ONLY|BUILD_INTERFACE):(.*)>$")
        set(item "${CMAKE_MATCH_2}")
    elseif("${item}" MATCHES "^\\$<INSTALL_INTERFACE:" OR "${item}" MATCHES "^::@")
        return()
    elseif("${item}" MATCHES "\\$<")
        message(FATAL_ERROR "Unsupported static link expression: ${item}")
    endif()
    if(NOT item)
        return()
    endif()
    if(TARGET "${item}")
        get_target_property(alias "${item}" ALIASED_TARGET)
        if(alias)
            set(item "${alias}")
        endif()
        get_property(visited GLOBAL PROPERTY MRACLE_LINK_VISITED)
        if("${item}" IN_LIST visited)
            return()
        endif()
        set_property(GLOBAL APPEND PROPERTY MRACLE_LINK_VISITED "${item}")
        get_target_property(kind "${item}" TYPE)
        if(NOT kind STREQUAL "INTERFACE_LIBRARY")
            if(NOT kind MATCHES "^(STATIC|SHARED|UNKNOWN)_LIBRARY$")
                message(FATAL_ERROR "Cannot link native target ${item} (${kind})")
            endif()
            set_property(GLOBAL APPEND PROPERTY MRACLE_LINK_ITEMS "$<TARGET_LINKER_FILE:${item}>")
        endif()
        foreach(property LINK_LIBRARIES INTERFACE_LINK_LIBRARIES INTERFACE_LINK_OPTIONS)
            get_target_property(dependencies "${item}" "${property}")
            if(dependencies)
                foreach(dependency IN LISTS dependencies)
                    mracle_collect_link("${dependency}")
                endforeach()
            endif()
        endforeach()
    else()
        if(item MATCHES "::")
            message(FATAL_ERROR "Native dependency target is not visible here: ${item}")
        endif()
        if(item MATCHES "^LINKER:")
            string(REGEX REPLACE "^LINKER:" "-Wl," item "${item}")
        endif()
        set_property(GLOBAL APPEND PROPERTY MRACLE_LINK_ITEMS "${item}")
    endif()
endfunction()

function(mracle_export_static_link target)
    set_property(GLOBAL PROPERTY MRACLE_LINK_VISITED "")
    set_property(GLOBAL PROPERTY MRACLE_LINK_ITEMS "")
    mracle_collect_link("${target}")
    # C++ runtime libraries are normally added by the C++ linker driver. Rust
    # supplies the final driver, so include the host compiler's runtime list.
    foreach(library IN LISTS CMAKE_CXX_IMPLICIT_LINK_LIBRARIES)
        mracle_collect_link("${library}")
    endforeach()
    get_property(items GLOBAL PROPERTY MRACLE_LINK_ITEMS)
    list(REMOVE_DUPLICATES items)
    string(JOIN "\n" manifest ${items})
    file(GENERATE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/native-link.txt"
        CONTENT "${manifest}\n")
endfunction()
